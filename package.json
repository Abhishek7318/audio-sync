{
  "name": "storyreel-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "StoryReel Studio - Desktop AI Story to Video Generator",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:ui": "vite",
    "dev:backend": "./venv/bin/python backend/run.py",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:ui\" \"wait-on http://localhost:5173 && electron .\"",
    "build:ui": "tsc && vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  }
}
